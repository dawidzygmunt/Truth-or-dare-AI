# Copy to .env and adjust. Never commit .env.

# api
PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://tod:tod@localhost:5432/tod

# docker compose (Postgres)
POSTGRES_USER=tod
POSTGRES_PASSWORD=tod
POSTGRES_DB=tod
# Host port. Change it when 5432 is taken, and update DATABASE_URL too.
# `pnpm test:e2e` ignores these: it runs its own compose project `tod-e2e` on port 55432.
# Remove that database with: docker compose -p tod-e2e down -v
POSTGRES_PORT=5432

# mail (Mailpit locally)
SMTP_HOST=localhost
SMTP_PORT=1025

# web dev server proxy target for /api
API_URL=http://localhost:3000
